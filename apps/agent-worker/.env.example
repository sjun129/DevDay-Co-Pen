PORT=1235
SYNC_SERVER_URL=ws://localhost:1234
# 동기화 서버와 같은 값이어야 한다
AGENT_SHARED_SECRET=change-me-dev-secret

# 비워 두면 목업 스트림으로 동작한다 (키 없이 개발·데모 가능)
OPENAI_API_KEY=
# 키를 넣으면 필수. 응답이 빠른 모델을 권장
OPENAI_MODEL=
# OpenAI 호환 API 주소. 비우면 OpenAI 본가. Qwen(알리바바 Model Studio) 예시:
#   OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen-plus
# Gemini(Google AI Studio) 예시:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-flash-lite-latest
OPENAI_BASE_URL=

# 토큰을 묶어 반영하는 간격(ms)
AGENT_FLUSH_MS=50
