PORT=1234
APP_ENV=development
PERSISTENCE_BACKEND=file
AGENT_WORKER_URL=http://localhost:1235
# planning/writing 작업을 재실행하지 않고 error로 종료할 기준(ms)
JOB_STALE_AFTER_MS=900000
# 워커와 같은 값이어야 한다. 배포 시 반드시 긴 랜덤 문자열로 교체
AGENT_SHARED_SECRET=change-me-dev-secret
GUEST_TOKEN_SECRET=change-me-guest-token-secret-at-least-32-bytes

# PERSISTENCE_BACKEND=supabase일 때 두 값 모두 필수
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DATA_DIR=.data
